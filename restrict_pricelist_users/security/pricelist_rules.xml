<odoo>
    <record id="res_groups_privilege_pricelists" model="res.groups.privilege">
        <field name="name">Pricelists</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="placeholder">Not restricted</field>
    </record>

    <record id="group_view_own_pricelists" model="res.groups">
        <field name="name">Own Pricelists</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pricelists"/>
    </record>

    <record id="group_view_all_pricelists" model="res.groups">
        <field name="name">All Pricelists</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pricelists"/>
        <field name="implied_ids" eval="[(4, ref('group_view_own_pricelists'))]"/>
    </record>

    <!--
        Odoo 20 replaced ir.model.access / ir.rule with ir.access:
        permissions (with a group) are OR-ed together, restrictions (without a
        group) are AND-ed on top of them. A group permission would therefore be
        OR-ed with the unrestricted read permission that product gives to
        base.group_user and would filter nothing, so the visibility filter is a
        global restriction that only bites for users in "Own Pricelists"
        without "All Pricelists".
    -->
    <record id="access_restrict_own_pricelists" model="ir.access">
        <field name="name">Restrict pricelists to allowed users</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="operation">r</field>
        <field name="domain">[] if (user.has_group('restrict_pricelist_users.group_view_all_pricelists') or not user.has_group('restrict_pricelist_users.group_view_own_pricelists')) else ['|', ('allowed_users', 'in', user.id), ('allowed_users', '=', False)]</field>
    </record>
</odoo>
